# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local database (regenerate with `npx prisma migrate dev` + `npm run db:seed`)
*.db
*.db-journal
*.db-wal
*.db-shm

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be tracked, otherwise a fresh clone has no idea
# which variables the app expects.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# agent tooling copies, not app source
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
